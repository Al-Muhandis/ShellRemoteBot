#!/bin/sh
# postinst script for tgshd
set -e

case "$1" in
    configure)
        # /run/systemd/system is the canonical "systemd is in charge" check:
        # is-system-running exits non-zero for state "degraded" (failed units
        # elsewhere) and would skip the whole block
        if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload || true
            systemctl enable tgshd.service || true
            # start (or restart on upgrade to pick up the new binary)
            systemctl restart tgshd.service || true
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        ;;
esac

exit 0
